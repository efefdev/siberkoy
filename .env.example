# ──────────────────────────────────────────────
# OMÜ Siber — Siber Köy Platform Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env
# .env dosyasını asla Git'e göndermeyin!
# ──────────────────────────────────────────────

# ─── Veritabanı ───────────────────────────────
POSTGRES_DB=siberkoy
POSTGRES_USER=siberkoy_user
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
# Yukarıdaki kullanıcı/şifre ile aynı olmalı
DATABASE_URL="postgresql://siberkoy_user:BURAYA_GUCLU_BIR_SIFRE_YAZIN@db:5432/siberkoy"

# ─── Güvenlik ─────────────────────────────────
# JWT imzalama anahtarı — zorunlu, en az 32 karakter (önerilen 128 hex):
#   openssl rand -hex 64
# Tanımlı değilse veya kısaysa uygulama BAŞLAMAZ.
JWT_SECRET=

# ─── İlk admin hesabı ───
# ADMIN_EMAIL ve ADMIN_INITIAL_PASSWORD bu dosyaya YAZILMAZ; seed komutuna anlık verilir (README, adım 4).

# ─── Uygulama ─────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Alan Adı (CSP, Socket.io CORS ve Origin kontrolü bu adrese kilitlenir) ───
NEXT_PUBLIC_APP_URL=https://siberkoy.omusiber.org
