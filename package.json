{
  "name": "omusiberkoyu",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate",
    "admin": "node admin-app/server/launcher.mjs",
    "admin:build": "vite build --config admin-app/vite.config.mts",
    "test:admin": "node --test admin-app/server/guard.test.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@prisma/client": "^5.0.0",
    "argon2": "^0.40.1",
    "html-to-image": "1.11.13",
    "jose": "^5.2.3",
    "lucide-react": "^1.55.0",
    "next": "15.5.29",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.48.0",
    "eslint-config-next": "15.5.29",
    "jest": "^29.7.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.2",
    "vite": "6.4.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=20"
  }
}
