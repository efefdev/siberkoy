FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Bağımlılıkları önce kopyala (layer cache için)
COPY package.json package-lock.json ./
COPY prisma ./prisma/

RUN npm ci

# Kaynak kodu kopyala
COPY . .

EXPOSE 3000

# Migration → ilk admin (zaten varsa atlanır) → geliştirme sunucusu
CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed.js; node server.js"]
