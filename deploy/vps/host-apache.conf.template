# Sunucuda Nginx değil Apache varsa. /etc/apache2/sites-available/siberkoy.conf olarak kopyalanır.
# Gerekli modüller: proxy proxy_http proxy_wstunnel headers ssl rewrite. Eksik olan modülü etkinleştirmek
# (a2enmod) ana sunucunun genel ayarıdır: önce kullanıcıya sorulur (KURULUM.md).
# ADIM 1'de yalnızca :80 bloğu etkinleştirilir; sertifika alınınca :443 bloğunun yorumu kaldırılır.
<VirtualHost *:80>
    ServerName __DOMAIN__
    Alias /.well-known/acme-challenge/ /var/www/siberkoy-acme/.well-known/acme-challenge/
    <Directory /var/www/siberkoy-acme>
        Require all granted
    </Directory>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

